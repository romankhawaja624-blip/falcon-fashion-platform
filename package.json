{
  "name": "falcon-atelier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "server": "npx tsx backend/server.ts",
    "server:watch": "npx tsx --watch backend/server.ts",
    "db:migrate": "npx tsx -e \"require('dotenv').config(); import('./backend/db/migrate').then(m => m.applySchema().then(() => process.exit(0)))\"",
    "db:seed": "npx tsx -e \"require('dotenv').config(); import('./backend/db/seed').then(m => m.seedDatabase().then(() => process.exit(0)))\"",
    "test:backend": "npx tsx backend/tests/integration.ts",
    "dev:full": "npx tsx backend/server.ts & vite"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "^4.23.12",
    "typescript": "latest"
  }
}
